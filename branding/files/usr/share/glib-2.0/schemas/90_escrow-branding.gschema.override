# Escrow OS default wallpaper for GNOME (stock Ubuntu desktop).
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/escrow/escrow-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/escrow/escrow-wallpaper.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/escrow/escrow-wallpaper.png'
