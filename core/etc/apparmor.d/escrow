# Escrow: allow the sandbox helper (and only it) to create unprivileged user
# namespaces, which Ubuntu 23.10+ restricts by default
# (kernel.apparmor_restrict_unprivileged_userns=1).
abi <abi/4.0>,
include <tunables/global>

profile escrow-enter /usr/lib/escrow/escrow-enter flags=(unconfined) {
  userns,

  include if exists <local/escrow-enter>
}
