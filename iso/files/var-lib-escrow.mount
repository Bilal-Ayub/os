[Unit]
Description=Escrow OS session staging on tmpfs (live session only)
Documentation=file:///usr/share/doc/escrow/README.md
# The live root is itself an overlayfs, and overlayfs refuses another overlayfs
# as its upper directory, so escrow cannot stage under the live /var/lib/escrow.
# An installed system (ext4/btrfs) never matches this condition.
# casper mounts the squashfs at /rofs; 26.04 no longer puts boot=casper on
# the kernel command line, so test for the mount instead.
ConditionPathIsMountPoint=/rofs
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=tmpfs
Where=/var/lib/escrow
Type=tmpfs
Options=mode=1777,nosuid,nodev,size=50%

[Install]
WantedBy=local-fs.target
